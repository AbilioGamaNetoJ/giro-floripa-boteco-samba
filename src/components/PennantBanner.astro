---
const colors = ["#8B1E1E", "#E3A008", "#C4452A", "#E07A2F", "#FFF6E8"];
const flags = Array.from({ length: 28 }, (_, index) => colors[index % colors.length]);
---

<div class="flex overflow-hidden" aria-hidden="true">
  {flags.map((color) => (
    <span
      class="h-7 w-6 shrink-0 sm:h-8 sm:w-7"
      style={`background:${color};clip-path:polygon(0 0,100% 0,50% 100%)`}
    />
  ))}
</div>
